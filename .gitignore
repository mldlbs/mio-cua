# Local model weights (OmniParser repo + ~1.3GB weights), download not committed
models/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

dist/

# Pre-publish content drafts (release schedule + release notes) - not public
publish/

# Local LLM credentials - never commit
.llm_env
*.secret

# Trace artifacts: screenshots, raw captures, run logs - all regenerated by
# running the scenarios. Kept out so a session does not add 100+MB; the
# historical trace/artifacts/*.png committed before this rule are unaffected
# (gitignore only applies to untracked files).
trace/artifacts_*/
trace/screenshots/
trace/screenshots_*/
trace/_repro_shots/
trace/tmp_probe/
traces/
*.raw.png
trace/*.log
trace/*.err
trace/*.pid
# timestamp-named stray captures (bench runs, one-off probes); the paired
# recon_chatgpt.png kept -- it documents the recon_chatgpt.json fixture
trace/[0-9]*.png
trace/_bench_overlay.png
